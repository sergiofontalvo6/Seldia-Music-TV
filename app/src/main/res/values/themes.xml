<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SeldiaMusic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Acento dinámico por defecto: rojo -->
        <item name="accentPrimary">@color/accent_red</item>
        <item name="accentSoft">@color/accent_red_soft</item>
        <item name="accentSecondary">@color/accent_red_secondary</item>
        <item name="accentPrimaryDark">@color/accent_red_dark</item>

        <!-- Glass por defecto: equivalencias clásicas (sin cambiar el tema actual) -->
        <item name="glassBackground">@color/background</item>
        <item name="glassSidebar">@color/sidebar_bg</item>
        <item name="glassPanel">@color/glass_surface_high</item>
        <item name="glassStroke">@color/glass_stroke</item>

        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.SeldiaMusic.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SeldiaMusic.Dialog</item>
    </style>

    <!-- ===== Overlays de acento (se eligen en runtime según ThemePrefs) ===== -->
    <style name="Theme.SeldiaMusic.AccentRed" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_red</item>
        <item name="accentSoft">@color/accent_red_soft</item>
        <item name="accentSecondary">@color/accent_red_secondary</item>
        <item name="accentPrimaryDark">@color/accent_red_dark</item>
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red</item>
        <item name="colorSecondary">@color/accent_red_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentOrange" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_orange</item>
        <item name="accentSoft">@color/accent_orange_soft</item>
        <item name="accentSecondary">@color/accent_orange_secondary</item>
        <item name="accentPrimaryDark">@color/accent_orange_dark</item>
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorPrimaryVariant">@color/accent_orange</item>
        <item name="colorSecondary">@color/accent_orange_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentAmber" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_amber</item>
        <item name="accentSoft">@color/accent_amber_soft</item>
        <item name="accentSecondary">@color/accent_amber_secondary</item>
        <item name="accentPrimaryDark">@color/accent_amber_dark</item>
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber</item>
        <item name="colorSecondary">@color/accent_amber_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentGreen" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_green</item>
        <item name="accentSoft">@color/accent_green_soft</item>
        <item name="accentSecondary">@color/accent_green_secondary</item>
        <item name="accentPrimaryDark">@color/accent_green_dark</item>
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green</item>
        <item name="colorSecondary">@color/accent_green_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentTeal" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_teal</item>
        <item name="accentSoft">@color/accent_teal_soft</item>
        <item name="accentSecondary">@color/accent_teal_secondary</item>
        <item name="accentPrimaryDark">@color/accent_teal_dark</item>
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryVariant">@color/accent_teal</item>
        <item name="colorSecondary">@color/accent_teal_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentBlue" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_blue</item>
        <item name="accentSoft">@color/accent_blue_soft</item>
        <item name="accentSecondary">@color/accent_blue_secondary</item>
        <item name="accentPrimaryDark">@color/accent_blue_dark</item>
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentPurple" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_purple</item>
        <item name="accentSoft">@color/accent_purple_soft</item>
        <item name="accentSecondary">@color/accent_purple_secondary</item>
        <item name="accentPrimaryDark">@color/accent_purple_dark</item>
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorPrimaryVariant">@color/accent_purple</item>
        <item name="colorSecondary">@color/accent_purple_secondary</item>
    </style>

    <style name="Theme.SeldiaMusic.AccentPink" parent="Theme.SeldiaMusic">
        <item name="accentPrimary">@color/accent_pink</item>
        <item name="accentSoft">@color/accent_pink_soft</item>
        <item name="accentSecondary">@color/accent_pink_secondary</item>
        <item name="accentPrimaryDark">@color/accent_pink_dark</item>
        <item name="colorPrimary">@color/accent_pink</item>
        <item name="colorPrimaryVariant">@color/accent_pink</item>
        <item name="colorSecondary">@color/accent_pink_secondary</item>
    </style>

    <!-- ===== Glass (iPhone): imita iOS — wallpaper + paneles translúcidos ===== -->
    <style name="Theme.SeldiaMusic.Glass" parent="Theme.SeldiaMusic">
        <item name="glassBackground">@drawable/bg_glass_wallpaper</item>
        <item name="glassSidebar">@color/glass_sidebar</item>
        <item name="glassPanel">@color/glass_panel</item>
        <item name="glassStroke">@color/glass_stroke_brighter</item>

        <item name="android:windowBackground">@drawable/bg_glass_wallpaper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Tipografía limpia estilo Apple (sans-serif del sistema) -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Acento por defecto: rojo (sobrescrito en variantes Glass+acento) -->
        <item name="accentPrimary">@color/accent_red</item>
        <item name="accentSoft">@color/accent_red_soft</item>
        <item name="accentSecondary">@color/accent_red_secondary</item>
        <item name="accentPrimaryDark">@color/accent_red_dark</item>
    </style>

    <style name="Theme.SeldiaMusic.Glass.AccentRed" parent="Theme.SeldiaMusic.Glass" />

    <style name="Theme.SeldiaMusic.Glass.AccentOrange" parent="Theme.SeldiaMusic.Glass">
        <item name="accentPrimary">@color/accent_orange</item>
        <item name="accentSoft">@color/accent_orange_soft</item>
        <item name="accentSecondary">@color/accent_orange_secondary</item>
        <item name="accentPrimaryDark">@color/accent_orange_dark</item>
    </style>

    <style name="Theme.SeldiaMusic.Glass.AccentAmber" parent="Theme.SeldiaMusic.Glass">
        <item name="accentPrimary">@color/accent_amber</item>
        <item name="accentSoft">@color/accent_amber_soft</item>
