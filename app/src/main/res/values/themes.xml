        <item name="accentSoft">@color/accent_teal_soft</item>
        <item name="accentSecondary">@color/accent_teal_secondary</item>
        <item name="accentPrimaryDark">@color/accent_teal_dark</item>
    </style>

    <style name="Theme.SeldiaMusic.Glass.AccentBlue" parent="Theme.SeldiaMusic.Glass">
        <item name="accentPrimary">@color/accent_blue</item>
        <item name="accentSoft">@color/accent_blue_soft</item>
        <item name="accentSecondary">@color/accent_blue_secondary</item>
        <item name="accentPrimaryDark">@color/accent_blue_dark</item>
    </style>

    <style name="Theme.SeldiaMusic.Glass.AccentPurple" parent="Theme.SeldiaMusic.Glass">
        <item name="accentPrimary">@color/accent_purple</item>
        <item name="accentSoft">@color/accent_purple_soft</item>
        <item name="accentSecondary">@color/accent_purple_secondary</item>
        <item name="accentPrimaryDark">@color/accent_purple_dark</item>
    </style>

    <style name="Theme.SeldiaMusic.Glass.AccentPink" parent="Theme.SeldiaMusic.Glass">
        <item name="accentPrimary">@color/accent_pink</item>
        <item name="accentSoft">@color/accent_pink_soft</item>
        <item name="accentSecondary">@color/accent_pink_secondary</item>
        <item name="accentPrimaryDark">@color/accent_pink_dark</item>
    </style>

    <style name="ThemeOverlay.SeldiaMusic.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.SeldiaMusic.BottomSheet</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <style name="Widget.SeldiaMusic.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.SeldiaMusic.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_high</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">?attr/accentPrimary</item>
    </style>
</resources>
