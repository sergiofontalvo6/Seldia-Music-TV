<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"

    android:clipToPadding="false"
    android:focusable="false"
    app:cardBackgroundColor="?attr/glassPanel"
    app:cardCornerRadius="26dp"
    app:cardElevation="10dp"
    app:strokeColor="?attr/glassStroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Grupo izquierdo: pista actual -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_focus_pill"
                android:contentDescription="@string/add_favorite"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@id/btn_play_pause"
                android:nextFocusLeft="@id/btn_play_pause"
                android:nextFocusRight="@+id/btn_shuffle"
                android:nextFocusUp="@id/content_container"
                android:src="@drawable/ic_favorite"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Grupo central: controles + progreso -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2.3"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_shuffle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:contentDescription="@string/shuffle_all"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusDown="@+id/btn_lyrics"
                    android:nextFocusLeft="@+id/btn_prev"
                    android:nextFocusRight="@+id/btn_prev"
                    android:nextFocusUp="@id/content_container"
                    android:padding="10dp"
                    android:src="@drawable/ic_shuffle"
                    android:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:contentDescription="@string/prev_track_desc"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:nextFocusDown="@+id/btn_lyrics"
                    android:nextFocusLeft="@+id/btn_shuffle"
                    android:nextFocusRight="@+id/btn_play_pause"
                    android:nextFocusUp="@id/content_container"
                    android:padding="14dp"
                    android:src="@drawable/ic_prev"
                    android:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_play_button"
                    android:contentDescription="@string/play_all"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:minWidth="56dp"
                    android:minHeight="56dp"
                    android:nextFocusDown="@+id/btn_lyrics"
                    android:nextFocusLeft="@+id/btn_prev"
                    android:nextFocusRight="@+id/btn_next"
                    android:nextFocusUp="@id/content_container"
                    android:padding="14dp"
                    android:src="@drawable/ic_play"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:contentDescription="@string/next_track_desc"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:nextFocusDown="@+id/btn_lyrics"
                    android:nextFocusLeft="@+id/btn_play_pause"
                    android:nextFocusRight="@+id/btn_repeat"
                    android:nextFocusUp="@id/content_container"
                    android:padding="14dp"
                    android:src="@drawable/ic_next"
                    android:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btn_repeat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:contentDescription="@string/repeat_desc"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusDown="@+id/btn_lyrics"
                    android:nextFocusLeft="@+id/btn_next"
                    android:nextFocusRight="@+id/btn_lyrics"
                    android:nextFocusUp="@id/content_container"
                    android:padding="10dp"
                    android:src="@drawable/ic_repeat"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="34dp"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:nextFocusDown="@+id/btn_play_pause"
                    android:nextFocusLeft="@+id/btn_lyrics"
                    android:nextFocusRight="@+id/btn_lyrics"
                    android:nextFocusUp="@id/content_container"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="?attr/accentPrimary"
                    android:thumbTint="?attr/accentPrimary"
                    android:splitTrack="false"
                    style="?android:attr/progressBarStyleHorizontal" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="34dp"
                    android:text="0:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grupo derecho: cola, letra, volumen -->
        <LinearLayout
            android:id="@+id/right_cluster"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_lyrics"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tv_focus_pill"
                android:contentDescription="@string/lyrics_button"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@+id/volume_bar"
                android:nextFocusLeft="@+id/btn_repeat"
                android:nextFocusRight="@+id/btn_lyrics"
                android:nextFocusUp="@id/content_container"
                android:padding="10dp"
                android:src="@drawable/ic_lyrics"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btn_queue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_tv_focus_pill"
                android:contentDescription="@string/queue_desc"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@+id/volume_bar"
                android:nextFocusLeft="@+id/btn_lyrics"
                android:nextFocusRight="@+id/volume_bar"
                android:nextFocusUp="@id/content_container"
                android:padding="10dp"
                android:src="@drawable/ic_queue"
                android:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/iv_volume_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume"
                android:tint="@color/text_secondary" />

            <SeekBar
                android:id="@+id/volume_bar"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@+id/btn_play_pause"
                android:nextFocusLeft="@+id/btn_queue"
                android:nextFocusRight="@+id/btn_play_pause"
                android:nextFocusUp="@+id/btn_lyrics"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/text_secondary"
                android:thumbTint="@color/text_primary"
                android:splitTrack="false" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
