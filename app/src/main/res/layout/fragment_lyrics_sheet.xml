<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="620dp"
    android:background="@drawable/bg_glass_sheet"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="46dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_glass_pill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_sheet_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/lyrics_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sheet_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sync_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/lyrics_synced_badge"
            android:textColor="?attr/accentPrimary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_close_lyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/glass_stroke" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <!-- Karaoke: líneas sincronizadas, tipografía grande -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="28dp"
            android:paddingBottom="120dp"
            android:visibility="gone" />

        <!-- Fallback sin marcas de tiempo -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_lyrics_plain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:scrollbars="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_lyrics_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:lineSpacingExtra="12dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/text_primary"
                android:textSize="21sp" />
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progress_lyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/accentPrimary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
