<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_gradient"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- Header: título + chip de fuente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/now_playing_label"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <TextView
            android:id="@+id/tv_source_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/source_chip_youtube"
            android:textColor="?attr/accentPrimary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Pestañas Audio / Vídeo -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/mode_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_gravity="center_horizontal"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_audio"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/mode_audio"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/glass_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_video"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/mode_video"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/glass_stroke" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Área de visualización: carátula (audio) o PlayerView (video) -->
    <LinearLayout
        android:id="@+id/display_area"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:background="@color/glass_card"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/artwork_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/glass_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/iv_big_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/video_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:background="@android:color/black"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:show_timeout="3000"
                app:use_controller="false" />

            <ImageButton
                android:id="@+id/btn_fullscreen_enter"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_glass_pill"
                android:contentDescription="@string/fullscreen"
                android:elevation="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_fullscreen"
                android:tint="@color/text_primary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_fullscreen_exit"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_glass_pill"
                android:contentDescription="@string/fullscreen_exit"
                android:elevation="8dp"
                android:padding="10dp"
                android:src="@drawable/ic_fullscreen_exit"
                android:tint="@color/text_primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Título y artista -->
    <TextView
        android:id="@+id/tv_np_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_np_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Barra de progreso -->
    <LinearLayout
        android:id="@+id/seek_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="@color/glass_stroke"
            android:progressTint="?attr/accentPrimary"
            android:thumbTint="?attr/accentPrimary"
            android:splitTrack="false" />

        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Acciones secundarias: favorito, descarga, cola -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_np_lyrics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@string/lyrics_button"
            android:padding="11dp"
            android:src="@drawable/ic_lyrics"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_np_favorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@null"
            android:padding="11dp"
            android:src="@drawable/ic_favorite"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_np_download"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@string/download_track"
            android:padding="11dp"
            android:src="@drawable/ic_download"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btn_np_queue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@null"
            android:padding="11dp"
            android:src="@drawable/ic_queue"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Barra flotante completa en pantalla completa (idéntica a la principal) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fs_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/glass_surface_high"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="46dp"
                android:layout_height="46dp"
                app:cardBackgroundColor="@color/surface_high"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/fs_iv_artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1.15"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fs_tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fs_tv_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/fs_btn_favorite"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_favorite"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/fs_btn_download"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/download_track"
                android:src="@drawable/ic_download"
                android:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/fs_btn_play_pause"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_play"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/fs_btn_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_prev"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/fs_btn_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_next"
                android:tint="@color/text_primary" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume"
                android:tint="@color/text_secondary" />

            <SeekBar
                android:id="@+id/fs_volume_bar"
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/text_secondary"
                android:thumbTint="@color/text_primary"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/fs_tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />

            <SeekBar
                android:id="@+id/fs_seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressTint="?attr/accentPrimary"
                android:thumbTint="?attr/accentPrimary"
                android:splitTrack="false"
                style="?android:attr/progressBarStyleHorizontal" />

            <TextView
                android:id="@+id/fs_tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="30dp"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />

            <ImageButton
                android:id="@+id/fs_btn_exit"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fullscreen_exit"
                android:padding="8dp"
                android:src="@drawable/ic_fullscreen_exit"
                android:tint="@color/text_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Indicador de descarga -->
    <ProgressBar
        android:id="@+id/progress_download"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:indeterminateTint="?attr/accentPrimary"
        android:visibility="gone" />
</LinearLayout>
