<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/glassBackground"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:descendantFocusability="afterDescendants"
        android:orientation="horizontal">

        <!-- ===== Panel izquierdo: biblioteca de navegación (fija, D-pad) ===== -->
        <LinearLayout
            android:id="@+id/sidebar_root"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="?attr/glassSidebar"

            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <!-- Marca + ajustes en cabecera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_seldia_logo" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/tv_brand_title"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_edition"
                        android:textColor="@color/text_secondary"
                        android:textSize="8sp"
                        android:letterSpacing="0.28" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_nav_settings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:contentDescription="@string/settings_title"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusRight="@id/content_container"
                    android:padding="9dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Estado de conectividad (conmutación online ⇄ offline) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <View
                    android:id="@+id/connectivity_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_online" />

                <TextView
                    android:id="@+id/tv_connectivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/online_status"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- Filtros biblioteca: Listas | Artistas | Buscar -->
            <LinearLayout
                android:id="@+id/filter_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"

               

                android:padding="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_filter_lists"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:nextFocusLeft="@id/content_container"
                    android:nextFocusRight="@+id/btn_filter_artists"
                    android:text="@string/lists"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_filter_artists"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:nextFocusLeft="@+id/btn_filter_lists"
                    android:nextFocusRight="@+id/btn_filter_search"
                    android:text="@string/artists"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_filter_search"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:nextFocusLeft="@+id/btn_filter_artists"
                    android:nextFocusRight="@id/content_container"
                    android:text="@string/nav_search"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Encabezado de playlists + crear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/playlists"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18" />

                <ImageButton
                    android:id="@+id/btn_new_playlist"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_tv_focus_pill"
                    android:contentDescription="@string/new_playlist"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:padding="8dp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Playlists con scroll propio (D-pad vertical) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_playlists"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipToPadding="false"

                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:nextFocusRight="@id/content_container"
                android:padding="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
            <!-- Pie fijo: Favoritas (debajo de las playlists) — Sin conexión eliminado del menú TV -->
            <LinearLayout
                android:id="@+id/btn_nav_liked"
                android:layout_marginBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tv_focus_sidebar"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:nextFocusLeft="@id/btn_nav_liked"
                android:nextFocusRight="@id/content_container"
                android:nextFocusUp="@+id/recycler_playlists"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:cardBackgroundColor="?attr/accentSoft"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_favorite_filled"
                        android:tint="?attr/accentPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/liked_songs_title"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_liked_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ayuda D-pad en TV -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tv_dpad_hint"
                android:textColor="@color/text_secondary"
                android:textSize="8sp" />

        </LinearLayout>

        <View
            android:id="@+id/divider_sidebar"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/glass_stroke" />

        <!-- ===== Panel central: encabezado + tabla ===== -->
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.6"
            android:background="?attr/glassBackground"
            android:descendantFocusability="afterDescendants"
            android:focusable="false" />

        <View
            android:id="@+id/divider_now_playing"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/glass_stroke" />

        <!-- ===== Panel derecho: "Sonando ahora" (reproductor integrado) ===== -->
        <include
            android:id="@+id/now_playing"
            layout="@layout/view_now_playing"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- ===== Barra inferior flotante ===== -->
    <include
        android:id="@+id/bottom_bar"
        layout="@layout/view_bottom_bar" />
</LinearLayout>
